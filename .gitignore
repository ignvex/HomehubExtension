# 前端
web/node_modules/
# dist 里只有 .gitkeep 进版本库：它让 //go:embed all:web/dist 在全新
# clone 上也能编译。构建产物一律不提交。
web/dist/*
!web/dist/.gitkeep
web/*.local

# 编辑器与系统
.DS_Store
.idea/
.vscode/
*.swp
