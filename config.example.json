{
  "version": 1,
  "server": {
    "addr": "127.0.0.1:8080",
    "public_url": "https://homehub.example.com",
    "allow_remote_listen": false,
    "read_header_timeout": "5s",
    "idle_timeout": "90s",
    "trusted_proxies": [
      "127.0.0.1/32",
      "::1/128"
    ],
    "max_body_bytes": 1048576
  },
  "auth": {
    "enabled": true,
    "server_key_path": "/var/lib/homehub-extension/server.key",
    "session_ttl": "168h",
    "challenge_ttl": "2m",
    "enrollment_ttl": "15m",
    "failed_attempt_limit": 10,
    "failed_attempt_window": "5m",
    "hub": {
      "enabled": true,
      "public_key_path": "/etc/homehub-extension/homehub.pub",
      "clock_skew": "60s",
      "nonce_ttl": "2m"
    }
  },
  "database": {
    "path": "/var/lib/homehub-extension/homehub.db",
    "busy_timeout": "5s",
    "read_conns": 3
  },
  "storage": {
    "blob_dir": "/var/lib/homehub-extension/blobs",
    "tmp_dir": "",
    "max_blob_bytes": 52428800,
    "quota_bytes": 5368709120,
    "min_free_bytes": 1073741824,
    "gc_grace": "1h"
  },
  "pastebin": {
    "enabled": true,
    "max_body_bytes": 262144,
    "default_expiry": "168h",
    "max_expiry": "8760h",
    "slug_length": 6,
    "allow_public": true,
    "language_list": [
      "text",
      "bash",
      "caddyfile",
      "css",
      "dockerfile",
      "go",
      "html",
      "ini",
      "javascript",
      "json",
      "lua",
      "markdown",
      "nginx",
      "python",
      "rust",
      "shell",
      "sql",
      "toml",
      "typescript",
      "xml",
      "yaml"
    ]
  },
  "rss": {
    "enabled": true,
    "default_interval": "30m",
    "min_interval": "10m",
    "max_interval": "6h",
    "fetch_concurrency": 2,
    "media_concurrency": 3,
    "fetch_timeout": "90s",
    "request_timeout": "20s",
    "user_agent": "HomehubExtension/0.1 (+https://homehub.example.com)",
    "max_feed_bytes": 5242880,
    "max_entry_bytes": 2097152,
    "allow_private_hosts": false,
    "referer": "auto"
  },
  "cleanup": {
    "timezone": "Asia/Shanghai",
    "catch_up": true,
    "jobs": [
      {
        "name": "paste-expired",
        "schedule": "0 * * * *",
        "timeout": "5m"
      },
      {
        "name": "session-expired",
        "schedule": "15 * * * *",
        "timeout": "2m"
      },
      {
        "name": "media-retry",
        "schedule": "*/30 * * * *",
        "timeout": "15m",
        "params": {
          "max_attempts": 3,
          "within": "72h"
        }
      },
      {
        "name": "rss-prune",
        "schedule": "30 4 * * *",
        "timeout": "20m",
        "params": {
          "older_than": "2160h",
          "keep_starred": true,
          "keep_unread": false
        }
      },
      {
        "name": "blob-gc",
        "schedule": "0 5 * * *",
        "timeout": "30m",
        "params": {
          "dry_run": false
        }
      },
      {
        "name": "db-vacuum",
        "schedule": "30 5 * * 0",
        "timeout": "1h",
        "params": {
          "mode": "incremental"
        }
      },
      {
        "name": "job-log-prune",
        "schedule": "0 6 * * 1",
        "timeout": "5m",
        "params": {
          "keep": "720h"
        }
      }
    ]
  },
  "log": {
    "level": "info",
    "format": "json",
    "access_log": true
  }
}
